#!/usr/bin/env bash
# arma-elevate — grant armamentarium a time-boxed extra root, from YOUR shell.
#
# This is the escalation mechanism for armamentarium's filesystem router
# (mcp_router/config.py load_elevation()). It writes
# ~/.config/armamentarium/elevate.json with an expiry; the router re-reads
# that file fresh on every request (no caching), so the grant takes effect
# immediately and expires on its own without you having to remember to
# revoke it. No tool reachable by an agent can write this file — only you,
# running this script, can grant access this way.
#
# Usage:
#   arma-elevate <path> [r|rw] [ttl_seconds]
#
# Examples:
#   arma-elevate ~/.config/Claude rw 900       # 15 min rw on Claude's config dir
#   arma-elevate ~/.config rw 1800             # 30 min rw on all of ~/.config
#   arma-elevate ~/Datasets/Haereticus r 3600  # 1 hr read-only on a sibling dataset
#
# Defaults: access=rw, ttl=3600 (1 hour).
#
# To check what's currently elevated: arma_router_status (via the MCP tool)
# reports an "elevation" block with active/expires_in_seconds/roots.
# To revoke early: arma-revoke (or just rm the file yourself).

set -euo pipefail

TARGET_PATH="${1:?usage: arma-elevate <path> [r|rw] [ttl_seconds]}"
ACCESS="${2:-rw}"
TTL="${3:-3600}"

if [[ "$ACCESS" != "r" && "$ACCESS" != "rw" ]]; then
  echo "error: access must be 'r' or 'rw', got '$ACCESS'" >&2
  exit 1
fi

CONFIG_DIR="$HOME/.config/armamentarium"
ELEVATE_FILE="$CONFIG_DIR/elevate.json"
mkdir -p "$CONFIG_DIR"

NOW=$(date +%s)
EXPIRES=$((NOW + TTL))

cat > "$ELEVATE_FILE" <<EOF
{
  "_comment": "Written by arma-elevate at $(date -d @"$NOW" 2>/dev/null || date -r "$NOW"). Not a place for an agent to write to itself.",
  "roots": [
    {"path": "$TARGET_PATH", "access": "$ACCESS"}
  ],
  "expires_at": $EXPIRES
}
EOF

echo "Elevated: $TARGET_PATH ($ACCESS) until $(date -d @"$EXPIRES" 2>/dev/null || date -r "$EXPIRES") (${TTL}s from now)"
echo "Revoke early with: arma-revoke"
